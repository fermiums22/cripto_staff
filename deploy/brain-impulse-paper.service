[Unit]
Description=Independent impulse PAPER execution controls (public data, no orders)
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/home/codex/projects/market-brain-storage
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=simple
User=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
Environment=OMP_NUM_THREADS=1
ExecStart=/bin/sh /home/codex/workspace/cripto_staff/deploy/brain-supervisor.sh brain_impulse_live.py --directory /home/codex/projects/market-brain-storage/impulse-paper-control-v1
Restart=on-failure
RestartSec=30
CPUQuota=70%
MemoryMax=768M
MemorySwapMax=0
Nice=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/projects/market-brain-storage/impulse-paper-control-v1
InaccessiblePaths=/home/codex/workspace/cripto_staff/secrets
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
