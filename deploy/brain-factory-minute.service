[Unit]
Description=Minute-horizon CUDA Market Brain research factory (PAPER research only)
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/home/codex/projects/market-brain-storage
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=simple
User=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
Environment=LD_LIBRARY_PATH=/home/codex/projects/market-brain-storage/cuda-packages/nvidia/cudnn/lib:/opt/nvidia-driver
Environment=PYTHONPATH=/home/codex/workspace/cripto_staff/.gpu-torch:/home/codex/workspace/cripto_staff/.venv/lib/python3.13/site-packages:/home/codex/projects/market-brain-storage/cuda-packages
Environment=OMP_NUM_THREADS=2
Environment=CUDA_CACHE_PATH=/home/codex/projects/market-brain-storage/factory-minute-v2/cuda-cache
ExecStartPre=/home/codex/workspace/cripto_staff/.venv/bin/python -u brain_minute_data.py --directory /home/codex/projects/market-brain-storage/factory-minute-v2/dataset
ExecStart=/home/codex/workspace/cripto_staff/.venv/bin/python -u brain_factory.py --directory /home/codex/projects/market-brain-storage/factory-minute-v2/run --dataset /home/codex/projects/market-brain-storage/factory-minute-v2/dataset
Restart=on-failure
RestartSec=120
TimeoutStartSec=1800
RuntimeMaxSec=2700
CPUQuota=150%
MemoryMax=3G
MemorySwapMax=256M
TasksMax=128
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/projects/market-brain-storage/factory-minute-v2
InaccessiblePaths=/home/codex/workspace/cripto_staff/secrets
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
