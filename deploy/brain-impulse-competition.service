[Unit]
Description=Bounded impulse model competition and validation (PAPER research only)
After=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
User=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
ExecStart=/bin/sh /home/codex/workspace/cripto_staff/deploy/brain-supervisor.sh brain_impulse_workflow.py --campaign /home/codex/projects/market-brain-storage/archive-campaign-v1 --output /home/codex/projects/market-brain-storage/impulse-competition-v2
CPUQuota=200%
MemoryMax=4G
MemorySwapMax=0
Nice=15
TimeoutStartSec=infinity
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/projects/market-brain-storage/impulse-competition-v2
InaccessiblePaths=/home/codex/workspace/cripto_staff/secrets
Environment=PYTHONDONTWRITEBYTECODE=1

