[Unit]
Description=Bounded evolutionary trading EXPLORATION (virtual accounts only)
After=network-online.target remote-fs.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
User=codex
Group=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
ExecStart=/bin/sh /home/codex/workspace/cripto_staff/deploy/brain-supervisor.sh brain_evolution_lab.py --campaign /home/codex/projects/market-brain-storage/archive-campaign-v1 --output /home/codex/projects/market-brain-storage/evolution-lab-v1
TimeoutStartSec=infinity
Nice=15
CPUQuota=100%
MemoryMax=4G
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/projects/market-brain-storage/evolution-lab-v1
InaccessiblePaths=/home/codex/workspace/cripto_staff/secrets
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
