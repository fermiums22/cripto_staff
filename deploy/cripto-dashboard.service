[Unit]
Description=Private LAN paper trading dashboard
After=network-online.target cripto-paper.service

[Service]
User=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
ExecStart=/home/codex/workspace/cripto_staff/.venv/bin/python dashboard.py --host 192.168.0.8
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
MemoryMax=256M

[Install]
WantedBy=multi-user.target
