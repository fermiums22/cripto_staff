[Unit]
Description=Raw-book leader impulse latency study (historical PAPER research)
After=network-online.target remote-fs.target
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
Type=oneshot
User=codex
Group=codex
WorkingDirectory=/home/codex/workspace/cripto_staff
ExecStart=/bin/sh /home/codex/workspace/cripto_staff/deploy/brain-supervisor.sh brain_leader_events.py --campaign /home/codex/projects/market-brain-storage/archive-campaign-v1 --output /home/codex/projects/market-brain-storage/leader-events-v1
TimeoutStartSec=infinity
CPUQuota=100%
MemoryMax=2G
MemorySwapMax=0
Nice=19
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/projects/market-brain-storage/leader-events-v1
InaccessiblePaths=/home/codex/workspace/cripto_staff/secrets
